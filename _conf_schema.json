{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true,
    "hint": "总开关，关闭后停止所有监控与分析。仅管理员可在 WebUI 修改。"
  },
  "provider_id": {
    "description": "LLM 服务商",
    "type": "string",
    "default": "",
    "_special": "select_provider",
    "hint": "留空则使用 AstrBot 全局默认的模型提供商"
  },
  "monitor_groups_mode": {
    "description": "群聊名单模式",
    "type": "string",
    "options": ["whitelist", "blacklist"],
    "default": "whitelist",
    "hint": "whitelist=只监控名单内的群, blacklist=排除名单内的群"
  },
  "monitored_groups": {
    "description": "群聊名单",
    "type": "list",
    "default": [],
    "hint": "填写群组ID或完整会话ID（可在目标群内发送 /sid 获取）。白名单=只监控这些群, 黑名单=排除这些群"
  },
  "monitor_users_mode": {
    "description": "用户名单模式",
    "type": "string",
    "options": ["whitelist", "blacklist"],
    "default": "blacklist",
    "hint": "blacklist=排除名单内的用户（推荐）, whitelist=只监控名单内的用户。⚠️ 慎用白名单模式：被分析的用户必须同时在白名单里才能被分析"
  },
  "monitored_users": {
    "description": "用户名单",
    "type": "list",
    "default": [],
    "hint": "填写用户ID。黑名单=排除这些用户, 白名单=只监控这些用户"
  },
  "admin_users": {
    "description": "超管用户",
    "type": "list",
    "default": [],
    "hint": "填写超管的用户ID，超管拥有所有命令权限，可通过命令修改配置"
  },
  "analysis_users": {
    "description": "被分析用户配置",
    "type": "template_list",
    "default": [],
    "hint": "按群-用户维度设置哪些用户的消息会被分析，以及谁有权限设置。命令添加的用户会自动同步到此处",
    "templates": {
      "entry": {
        "name": "群-用户条目",
        "display_item": "user_id",
        "items": {
          "group_id": {
            "description": "群组ID",
            "type": "string",
            "default": "",
            "hint": "留空表示全局生效（所有群和私聊）"
          },
          "user_id": {
            "description": "被分析用户ID",
            "type": "string",
            "default": "",
            "hint": "该用户的消息将被自动分析"
          },
          "can_set": {
            "description": "允许命令设置",
            "type": "bool",
            "default": false,
            "hint": "开启后该用户可通过命令将自己加入/移出分析列表"
          }
        }
      }
    }
  },
  "analysis_mode": {
    "description": "默认分析模式",
    "type": "string",
    "options": ["quick", "standard", "detailed"],
    "default": "standard",
    "hint": "未按群单独设置时使用的全局默认分析模式"
  },
  "analysis_mode_groups": {
    "description": "群分析模式配置",
    "type": "template_list",
    "default": [],
    "hint": "按群维度设置不同的分析模式，未配置的群将使用上方默认分析模式",
    "templates": {
      "entry": {
        "name": "群分析模式条目",
        "display_item": "group_id",
        "items": {
          "group_id": {
            "description": "群组ID",
            "type": "string",
            "default": "",
            "hint": "留空表示全局默认"
          },
          "mode": {
            "description": "分析模式",
            "type": "string",
            "options": ["quick", "standard", "detailed"],
            "default": "standard",
            "hint": "quick=简要, standard=标准, detailed=详细"
          },
          "can_set": {
            "description": "允许命令设置",
            "type": "bool",
            "default": false,
            "hint": "开启后该群成员可通过命令切换本群的分析模式"
          }
        }
      }
    }
  },
  "permission_status": {
    "description": "查询状态权限",
    "type": "string",
    "options": ["admin", "anyone"],
    "default": "admin",
    "hint": "admin=仅超管可查询运行状态, anyone=所有用户可查询"
  },
  "permission_stats": {
    "description": "查询统计权限",
    "type": "string",
    "options": ["admin", "anyone"],
    "default": "admin",
    "hint": "admin=仅超管可查看分析统计和配置概览, anyone=所有用户可查看"
  },
  "enable_intent_analysis": {
    "description": "意图解读",
    "type": "bool",
    "default": true,
    "hint": "分析对方话语的表面含义与真实意图，并给出概率评估"
  },
  "enable_emotion_detection": {
    "description": "情绪检测",
    "type": "bool",
    "default": true,
    "hint": "识别对方当前情绪状态、强度与变化趋势"
  },
  "enable_danger_assessment": {
    "description": "风险评估",
    "type": "bool",
    "default": true,
    "hint": "评估对话风险等级 (1-10)，高等级时发出紧急提醒"
  },
  "enable_action_advice": {
    "description": "行动建议",
    "type": "bool",
    "default": true,
    "hint": "提供推荐回应策略及成功率评估"
  },
  "danger_threshold": {
    "description": "危险警报阈值",
    "type": "int",
    "default": 7,
    "hint": "风险等级达到此值时附加紧急提醒（建议 6-8）"
  },
  "context_message_count": {
    "description": "上下文消息数",
    "type": "int",
    "default": 10,
    "hint": "分析时参考的历史消息条数，范围 1-50"
  },
  "cooldown_seconds": {
    "description": "分析冷却（秒）",
    "type": "int",
    "default": 30,
    "hint": "同一会话内两次分析的最小间隔，防止频繁调用 LLM"
  },
  "response_mode": {
    "description": "回复模式",
    "type": "string",
    "options": ["reply", "private"],
    "default": "reply",
    "hint": "reply=在原会话中回复, private=私聊发送给触发者（更隐蔽）"
  },
  "custom_system_prompt": {
    "description": "自定义分析提示词",
    "type": "text",
    "default": "",
    "hint": "留空使用内置提示词，填写后会追加到内置提示词之后，可用于定制分析风格"
  }
}
